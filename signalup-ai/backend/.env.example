APP_NAME=SignalUp AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=signalup_ai

JWT_SECRET_KEY=change-this-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

LOG_LEVEL=INFO